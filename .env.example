# --- Branding -------------------------------------------------------------
SITE_TITLE=Robotics
WELCOME_HEADING=Welcome to Robotics
TAGLINE=
# Logo (any URL, or /media/<file> from a mounted volume). Omit for no logo.
LOGO_URL=
# Inverted logo for dark mode (optional; LOGO_URL is for light backgrounds)
LOGO_DARK_URL=
LOGO_ALT=
LOGO_HREF=
FAVICON_URL=
FOOTER_TEXT=
FOOTER_SECONDARY_TEXT=VEX Robotics Competition

# --- Theme: neutral slate/blue by default; every value is optional (6-digit hex) ---
# THEME_MODE=auto            # auto | dark | light
# THEME_BG=#0F172A           # dark palette: BG BG2 CARD RAISE LINE INK MUTED ACCENT LINK OK RED BLUE
# THEME_LIGHT_BG=#F1F5F9     # light palette, same tokens
# IQ_COLOR=#0891B2
# V5_COLOR=#DC2626
# FONT_HEADING=
# FONT_HEADING_URL=

# --- Content --------------------------------------------------------------
# Convenience: base URL of a robotics-stats deployment. Generates the two
# default cards and four nav links when CARDS / NAV_LINKS are not set.
STATS_URL=http://localhost:8081
# Full control (JSON arrays). See README.md for the schema.
# NAV_LINKS=[{"label":"About","href":"https://example.org/about"}]
# CARDS=[{"title":"VIQRC Teams","subtitle":"Junior","image":"/media/viqrc.jpg","href":"https://example.org","color":"#0e7490"}]

# --- Server ---------------------------------------------------------------
PORT=8080
MEDIA_DIR=/media
